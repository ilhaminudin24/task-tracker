rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User can only access their own data
    match /users/{userId} {
      // Allow read/write to user's own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Projects collection - user scoped
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Validate project data on create
        allow create: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.name is string
                      && request.resource.data.name.size() >= 1
                      && request.resource.data.color in ['emerald', 'blue', 'amber', 'red', 'purple', 'pink'];
      }
      
      // Tasks collection - user scoped
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Validate task data on create
        allow create: if request.auth != null 
                      && request.auth.uid == userId
                      && request.resource.data.title is string
                      && request.resource.data.title.size() >= 1
                      && request.resource.data.projectId is string
                      && request.resource.data.category in ['work', 'personal', 'urgent']
                      && request.resource.data.priority in ['low', 'medium', 'high']
                      && request.resource.data.status in ['active', 'completed'];
      }
    }
  }
}
